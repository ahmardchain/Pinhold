# Pinhold agent configuration. Copy to .env and fill in. Never commit .env.

# testnet: Self + x402 on Celo Sepolia (USDC), Textile sandbox on BSC testnet (USDT 18 decimals).
# mainnet: everything on Celo (USD₮, cNGN). Needs ALLOW_MAINNET=yes as a second switch.
PINHOLD_NETWORK=testnet
ALLOW_MAINNET=no

# true: every check runs and every transaction is built and tagged, but nothing is sent,
# and the pay endpoint simulates the x402 payment.
DRY_RUN=true

# Pinhold's own wallet: x402 payTo, Textile taker, cNGN payouts, refunds. 0x + 64 hex.
AGENT_PRIVATE_KEY=

# From https://x402.celo.org (connect wallet, Create API key).
X402_API_KEY=

# Optional. Without it, Textile quotes are signed with a takerProof from AGENT_PRIVATE_KEY.
TEXTILE_API_KEY=

# Issued at Loops enrollment. Must equal codeFromRepo(GITHUB_REPO) or Pinhold will not start.
ATTRIBUTION_CODE=
GITHUB_REPO=ahmardchain/pinhold

# Telegram: bot token from @BotFather, a private chat the bot can post in (existence checks),
# and a chat for operator alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_LOG_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=

PUBLIC_BASE_URL=http://localhost:8787
PORT=8787
DATABASE_PATH=./data/pinhold.db

# Money limits (USD). The daily cap covers every outflow: swap input, refunds, surplus returns.
DAILY_CAP_USDT=25
MAX_BOOKING_USDT=10
# Mainnet: keep at 2 (Textile's floor is about $1). Testnet: 0.05, the sandbox corridor is tiny.
MIN_BOOKING_USDT=2
SURPLUS_MIN_RETURN_USDT=0.10
FX_BUFFER_BPS=200
MAX_OPEN_ESCROWS_PER_HUMAN=1
POST_DEADLINE_HOURS=12
CHECK_INTERVAL_MINUTES=10
DRY_RUN_NGN_PER_USD=1500
