{
  "name": "pinhold",
  "version": "0.1.0",
  "private": true,
  "description": "Escrow agent for Telegram channel ad placements on Celo",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "tsx --disable-warning=ExperimentalWarning src/main.ts",
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo:dry": "tsx --disable-warning=ExperimentalWarning scripts/demo-dry-run.ts",
    "verify": "tsx --disable-warning=ExperimentalWarning scripts/verify.ts",
    "sponsor": "tsx --disable-warning=ExperimentalWarning sponsor/cli.ts",
    "preflight": "tsx --disable-warning=ExperimentalWarning scripts/preflight.ts",
    "check:turnaway": "tsx --disable-warning=ExperimentalWarning scripts/check-turnaway.ts",
    "register:agent": "tsx --disable-warning=ExperimentalWarning scripts/register-agent.ts"
  },
  "dependencies": {
    "@celo/attribution-tags": "^0.5.0",
    "@selfxyz/agent-sdk": "^0.3.1",
    "@x402/core": "^2.32.0",
    "@x402/evm": "^2.32.0",
    "@x402/express": "^2.32.0",
    "@x402/fetch": "^2.32.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "grammy": "^1.46.0",
    "viem": "^2.58.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
